
@model UniversityDbApp.Models.Teacher

@{
    ViewData["Title"] = "Оқытушыны жою";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">
            Оқытушыны жою
        </h2>

        <p class="text-muted">
            Бұл әрекетті орындамас бұрын ақпаратты тексеріңіз.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="alert alert-warning">
                Бұл оқытушыны дерекқордан жойғыңыз келетініне сенімдісіз бе?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Аты-жөні</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Лауазымы</dt>
                <dd class="col-sm-9">
                    @(Model.Position ?? "Көрсетілмеген")
                </dd>

                <dt class="col-sm-3">Кафедрасы</dt>
                <dd class="col-sm-9">
                    @(Model.Department?.Name ?? "Белгісіз")
                </dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Иә, жою
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Болдырмау
                </a>

            </form>

        </div>
    </div>

</div>