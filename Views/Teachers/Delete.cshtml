
@model UniversityDbApp.Models.Teacher

@{
    ViewData["Title"] = "Оқытушыны жою";
}

<div class="page-heading">
    <div>
        <h1>Оқытушыны жою</h1>
        <p>Таңдалған оқытушыны жүйеден жою әрекетін растаңыз</p>
    </div>

    <a asp-action="Index" class="back-button">← Артқа</a>
</div>

<div class="delete-card">
    <div class="delete-icon">!</div>

    <h2>Оқытушыны жоюға сенімдісіз бе?</h2>

    <p class="delete-description">
        Бұл әрекет оқытушының деректерін дерекқордан жояды.
        Жалғастырмас бұрын мәліметтерді тексеріңіз.
    </p>

    <div class="delete-details">
        <div>
            <span>Оқытушы ID</span>
            <strong>#@Model.Id</strong>
        </div>

        <div>
            <span>Аты-жөні</span>
            <strong>@Model.FullName</strong>
        </div>

        <div>
            <span>Электрондық пошта</span>
            <strong>@Model.Email</strong>
        </div>

        <div>
            <span>Лауазымы</span>
            <strong>@(Model.Position ?? "Көрсетілмеген")</strong>
        </div>

        <div>
            <span>Кафедрасы</span>
            <strong>@(Model.Department?.Name ?? "Белгісіз")</strong>
        </div>
    </div>

    <div class="delete-warning">
        Ескерту: жою әрекетін растағаннан кейін оқытушының
        мәліметтері дерекқордан жойылады.
    </div>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        <div class="form-actions">
            <a asp-action="Index" class="cancel-button">
                Болдырмау
            </a>

            <button type="submit" class="delete-button">
                Иә, жою
            </button>
        </div>
    </form>
</div>
