
@model UniversityDbApp.Models.Teacher

@{
    ViewData["Title"] = "Оқытушы қосу";
}

<div class="page-heading">
    <div>
        <h1>Жаңа оқытушы</h1>
        <p>Университеттің профессорлық-оқытушылық құрамына жаңа маман тіркеу</p>
    </div>

    <a asp-action="Index" class="back-button">← Артқа</a>
</div>

<div class="form-card">
    <div class="form-card-header">
        <div class="form-icon">＋</div>
        <div>
            <h2>Оқытушы туралы ақпарат</h2>
            <p>Оқытушының жеке және қызметтік мәліметтерін енгізіңіз</p>
        </div>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="FullName">
                Аты-жөні <span>*</span>
            </label>

            <input asp-for="FullName"
                   class="form-control"
                   placeholder="Мысалы: Ахметов Нұрлан Ерланұлы" />

            <span asp-validation-for="FullName" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email">
                Электрондық пошта <span>*</span>
            </label>

            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   placeholder="teacher@university.kz" />

            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Position">Лауазымы</label>

            <input asp-for="Position"
                   class="form-control"
                   placeholder="Мысалы: Аға оқытушы, доцент, профессор" />

            <span asp-validation-for="Position" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="DepartmentId">
                Кафедра <span>*</span>
            </label>

            <select asp-for="DepartmentId"
                    asp-items="ViewBag.DepartmentId"
                    class="form-control">
                <option value="">Кафедраны таңдаңыз</option>
            </select>

            <span asp-validation-for="DepartmentId" class="field-error"></span>
        </div>

        <div class="form-note">
            <strong>*</strong> белгісімен көрсетілген өрістер міндетті.
            Электрондық пошта қайталанбауы керек.
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="cancel-button">
                Болдырмау
            </a>

            <button type="submit" class="submit-button">
                Оқытушыны сақтау
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
