
@model IEnumerable<UniversityDbApp.Models.Teacher>

@{
    ViewData["Title"] = "Оқытушылар";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Оқытушылар</h2>
            <p class="text-muted mb-0">
                Университет оқытушыларының деректер базасы
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Оқытушы қосу
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>№</th>
                                <th>Аты-жөні</th>
                                <th>Email</th>
                                <th>Лауазымы</th>
                                <th>Кафедрасы</th>
                                <th class="text-end">Әрекеттер</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int number = 1;
                            }

                            @foreach (var teacher in Model)
                            {
                                <tr>
                                    <td>@number</td>
                                    <td class="fw-semibold">
                                        @teacher.FullName
                                    </td>
                                    <td>@teacher.Email</td>
                                    <td>
                                        @(teacher.Position ?? "Көрсетілмеген")
                                    </td>
                                    <td>
                                        @(teacher.Department?.Name ?? "Белгісіз")
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@teacher.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Өңдеу
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@teacher.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Жою
                                        </a>
                                    </td>
                                </tr>

                                number++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5>Оқытушылар әлі тіркелмеген</h5>
                    <p class="text-muted">
                        Жүйеге алғашқы оқытушыны қосыңыз.
                    </p>
                    <a asp-action="Create" class="btn btn-primary">
                        Оқытушы қосу
                    </a>
                </div>
            }

        </div>
    </div>

    <div class="mt-3 text-muted">
        Жалпы оқытушылар саны:
        <strong>@Model.Count()</strong>
    </div>

</div>