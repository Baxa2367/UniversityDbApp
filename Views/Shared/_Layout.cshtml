
<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniManage</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="app">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">U</div>
                <div class="brand-text">
                    <strong>UniManage</strong>
                    <small>University System</small>
                </div>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-label">БАСТЫ МӘЗІР</div>

                <a class="nav-link @(currentController == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <span class="nav-icon">⌂</span>
                    <span>Басты бет</span>
                </a>

                <div class="nav-label">БАСҚАРУ</div>

                <a class="nav-link @(currentController == "Departments" ? "active" : "")"
                   asp-controller="Departments" asp-action="Index">
                    <span class="nav-icon">▦</span>
                    <span>Кафедралар</span>
                </a>

                <a class="nav-link @(currentController == "Teachers" ? "active" : "")"
                   asp-controller="Teachers" asp-action="Index">
                    <span class="nav-icon">♙</span>
                    <span>Оқытушылар</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="system-status">
                    <span class="status-dot"></span>
                    Жүйе белсенді
                </div>
                <small>ASP.NET Core 8</small>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <div class="topbar-heading">
                    <span class="breadcrumb">University / @ViewData["Title"]</span>
                    <h2>@ViewData["Title"]</h2>
                </div>

                <div class="user">
                    <div class="avatar">A</div>
                    <div class="user-info">
                        <strong>Administrator</strong>
                        <small>Басқарушы</small>
                    </div>
                </div>
            </header>

            <section class="content">
                @RenderBody()
            </section>

            <footer class="footer">
                <span>University Management System</span>
                <span>© 2026 UniManage</span>
            </footer>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
